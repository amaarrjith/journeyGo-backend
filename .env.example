# LLM Provider Configuration ("gemini" or "ollama")
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Google Gemini API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Ollama Configuration (if using local open-source models)
OLLAMA_BASE_URL=http://localhost:11434

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Optional Security API Key (Leave empty to allow all local requests)
API_KEY=
